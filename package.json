{
  "name": "diverdict",
  "version": "0.1.0",
  "description": "三思 Diverdict：三家独立出策、交叉质询、贾诩收敛。由宿主提供智能的 MCP server。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "diverdict": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "assets/brand",
    "docs/README.md",
    "docs/product",
    "docs/architecture",
    "docs/engineering",
    "docs/delivery",
    "examples"
  ],
  "keywords": [
    "mcp",
    "codex",
    "strategy",
    "decision-making",
    "multi-agent",
    "model-context-protocol"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test scripts package.json tsconfig.json biome.json",
    "format": "biome check --write src test scripts package.json tsconfig.json biome.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/** --test-coverage-exclude=dist/cli.js test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/cli.js",
    "smoke": "node scripts/smoke.mjs",
    "package:check": "node scripts/package-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
